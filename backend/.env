# ================================================
# AORA WISTARA BACKEND - ENVIRONMENT VARIABLES
# ================================================

# Server
PORT=5000
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aora_db

# JWT Secret (ganti dengan string random panjang)
JWT_SECRET=aora_wistara_super_secret_jwt_key_2024_change_this_in_production
JWT_EXPIRE=7d

# CORS - URL Frontend
FRONTEND_URL=http://localhost:5173

# Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
